{
  "name": "mini-tools",
  "description": "mini tools for express and others",
  "version": "1.13.13",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "files": [
    "lib"
  ],
  "repository": "codenautas/mini-tools",
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    }
  ],
  "overrides": {
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "stylus": {
      "glob": "^11"
    },
    "uuid": ">=14.0.0"
  },
  "dependencies": {
    "best-globals": "^2.2.3",
    "cast-error": "^0.1.7",
    "js-yaml": "^5.5.0",
    "pug": "^3.0.4",
    "send": "^1.2.1",
    "stylus": "^0.64.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/send": "^1.2.1",
    "escape-html": "^1.0.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "expect.js": "^0.3.1",
    "express": "^5.3.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "qa-control": "^0.14.2",
    "sinon": "^22.1.0",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "main": "lib/mini-tools.js",
  "types": "lib/mini-tools.d.ts",
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "prepare": "tsc",
    "test": "mocha --reporter spec --bail --check-leaks --exit test/",
    "test-ci": "nyc mocha --exit --check-leaks test/",
    "test-cov": "nyc mocha --exit test/",
    "start": "node example/server.js"
  },
  "nyc": {
    "extension": [
      ".ts",
      ".tsx"
    ],
    "exclude": [
      "**/*.d.ts",
      "coverage",
      "example",
      "test"
    ],
    "include": [
      "**"
    ],
    "reporter": [
      "html",
      "lcov",
      "text-summary"
    ],
    "all": true
  },
  "qa-control": {
    "gha": true,
    "run-in": "server",
    "test-appveyor": true,
    "type": "lib",
    "coverage": 95,
    "sonar": true
  }
}
